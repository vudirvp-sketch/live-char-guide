{
  "name": "live-char-guide",
  "version": "9.2.6",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Live Character Guide for LLM \u2014 Engineering pipeline for RP character cards",
  "scripts": {
    "build:glossary": "node scripts/generate_glossary.mjs",
    "build:enneagram": "node scripts/generate_enneagram.mjs",
    "build:unified": "node scripts/build-unified.mjs",
    "build:shell": "node src/scripts/build-shell-unified.mjs",
    "build": "node scripts/generate_glossary.mjs && node scripts/generate_enneagram.mjs && node scripts/build-unified.mjs && node scripts/generate-sitemap.mjs && node src/scripts/build-shell-unified.mjs",
    "build:check": "pnpm run build && pnpm run validate",
    "build:watch": "chokidar 'src/master/**/*' -c 'pnpm run build'",
    "validate": "node scripts/validate-artifact.mjs",
    "validate:master": "node scripts/validate-master.mjs",
    "version:check": "node scripts/version-sync.mjs",
    "test": "node --test tests/test-*.mjs tests/integration/*.mjs",
    "test:unit": "node --test tests/test-*.mjs",
    "test:integration": "node --test tests/integration/*.mjs",
    "test:a11y": "axe http://localhost:3000 --tags=wcag2a,wcag2aa --exit",
    "serve": "serve . -l 3000",
    "dev": "pnpm run build && pnpm run serve",
    "precommit": "pnpm run build && pnpm run validate && pnpm run validate:master",
    "prepare": "husky",
    "lint": "eslint src/",
    "lint:fix": "prettier --write .",
    "qa:csp": "node scripts/csp_check.mjs",
    "qa:bundle": "node scripts/bundle_check.mjs",
    "qa:contrast": "node scripts/contrast_checker.mjs visual-system/tokens.json",
    "qa:english": "node -e \"const{spawnSync}=require('child_process');const w=process.platform==='win32'?'python':'python3';const r=spawnSync(w,['scripts/check_english.py'],{stdio:'inherit',env:{...process.env,PYTHONIOENCODING:'utf-8'}});process.exit(r.status??1)\"",
    "qa:english:docs": "python3 scripts/check_english.py --scan-docs",
    "qa:syntax": "node -e \"const{spawnSync}=require('child_process');const w=process.platform==='win32'?'python':'python3';const r=spawnSync(w,['scripts/check_syntax_mix.py'],{stdio:'inherit',env:{...process.env,PYTHONIOENCODING:'utf-8'}});process.exit(r.status??1)\"",
    "qa:doc-versions": "node scripts/check-doc-versions.mjs",
    "qa:seo": "node scripts/seo_check.mjs",
    "qa:interactive": "node scripts/test-interactive.mjs",
    "qa": "pnpm run qa:csp && pnpm run qa:bundle && pnpm run qa:contrast && pnpm run qa:seo && pnpm run qa:english && pnpm run qa:syntax && pnpm run qa:doc-versions",
    "clean": "rm -rf node_modules package-lock.json pnpm-lock.yaml",
    "reinstall": "pnpm run clean && pnpm install"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.8.0",
    "@eslint/js": "^10.0.1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "node-html-parser": "^7.1.0",
    "prettier": "^3.2.0",
    "puppeteer": "^21.0.0",
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vudirvp-sketch/vudirvp-sketch.github.io.git"
  },
  "keywords": [
    "llm",
    "rp",
    "character-card",
    "ai",
    "persona"
  ],
  "author": "TITAN FUSE Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vudirvp-sketch/vudirvp-sketch.github.io/issues"
  },
  "homepage": "https://github.com/vudirvp-sketch/vudirvp-sketch.github.io#readme"
}
