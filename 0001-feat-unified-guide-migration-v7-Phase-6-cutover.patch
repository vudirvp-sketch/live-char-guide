-  // Widget containers that only exist on L2+ or L3
-  const WIDGET_SELECTORS = {
-    '#ocean-embed': { minLayer: 2, name: 'OCEAN' },
-    '#enneagram-embed': { minLayer: 2, name: 'Эннеаграмма' },
-    '#mbti-embed': { minLayer: 2, name: 'MBTI' },
