-<section data-layer="l2" data-section="p8_antipatterns_overview" data-toc-nav>
-<h2>Анти-паттерны</h2>
-
-<div class="table-wrap">
-<table>
-<thead><tr><th>Вы уже знаете (L1)</th><th>L2 добавляет</th></tr></thead>
