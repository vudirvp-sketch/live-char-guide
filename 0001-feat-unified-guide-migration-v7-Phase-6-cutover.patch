-
-    // If same layer, just scroll to anchor if provided
-    if (layer === currentLayer) {
-      if (anchor) {
-        scrollToAnchor(anchor);
-      }
-      return;
-    }
-
-    const previousLayer = currentLayer; // IMP-47: track previous layer
-    currentLayer = layer;
-    saveLayer(layer);
